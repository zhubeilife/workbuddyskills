{
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "init": {
    "darwin": "npm install --global --ignore-scripts --no-audit --no-fund \"https://welifepublicmedias.oss-cn-beijing.aliyuncs.com/workbuddy/acewill-welife-ai-connector-2.1.5.tgz\"",
    "linux": "npm install --global --ignore-scripts --no-audit --no-fund \"https://welifepublicmedias.oss-cn-beijing.aliyuncs.com/workbuddy/acewill-welife-ai-connector-2.1.5.tgz\"",
    "win32": "npm install --global --ignore-scripts --no-audit --no-fund \"https://welifepublicmedias.oss-cn-beijing.aliyuncs.com/workbuddy/acewill-welife-ai-connector-2.1.5.tgz\""
  },
  "auth": {
    "darwin": "welife-ai-connector auth login",
    "linux": "welife-ai-connector auth login",
    "win32": "welife-ai-connector.cmd auth login"
  },
  "unAuth": {
    "darwin": "welife-ai-connector auth logout",
    "linux": "welife-ai-connector auth logout",
    "win32": "welife-ai-connector.cmd auth logout"
  },
  "status": {
    "darwin": "welife-ai-connector auth status",
    "linux": "welife-ai-connector auth status",
    "win32": "welife-ai-connector.cmd auth status"
  },
  "versionCheck": {
    "command": {
      "darwin": "welife-ai-connector --version",
      "linux": "welife-ai-connector --version",
      "win32": "welife-ai-connector.cmd --version"
    },
    "minVersion": "2.1.5",
    "versionPattern": "(\\d+\\.\\d+\\.\\d+)"
  },
  "statusMatchJson": {
    "status": "authorized"
  },
  "authUrlDomain": "manage.acewill.net",
  "authWaitForExit": true
}
