        "pageSize",
        "filter.userType",
        "filter.startDate",
        "filter.endDate",
        "filter.timezoneOffset",
        "filter.userIds",
        "filter.empIds"
      ],
      "notes": "实测：filter.userIds/empIds/userId/creator 被服务端忽略（恒定返回登录人）；startDate/endDate 不生效；pageNo 被忽略，pageSize 上限 300"
    },
    {
      "id": "GET /api/blog/prior/detailsByDate",
      "source": "references/daily-report-blog-details-by-date.md",
      "operations": [
        "blog.query_user",
        "blog.publish.prepare",
        "blog.publish.apply",
        "blog.edit.prepare",
        "blog.edit.apply",
        "blog.comment.prepare",
        "blog.like.prepare"
      ],
      "fields": [
        "date",
        "userId"
      ],
      "notes": "响应无 found 字段；无日报时返回空壳 blog 对象，判定必须看 blog.id"
    },
    {
      "id": "POST /api/hrm/common/browser/count/resource",
      "source": "references/daily-report-blog-details-by-date.md",
      "operations": [
        "blog.resolve_users",
