        "blog.atLinkList",
        "blog.deleteTargetType",
        "blog.client",
        "timezoneOffset"
      ],
      "notes": "服务端不限制同日重复提交，发布前必须查重；发布后需另行设置默认共享"
    },
    {
      "id": "POST /api/blog/prior/updateBlog",
