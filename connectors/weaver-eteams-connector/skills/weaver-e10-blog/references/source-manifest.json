        "blog.remind.prepare"
      ],
      "fields": [
        "formDatas.username",
        "status",
        "subcompany",
        "department",
        "role",
        "position",
        "superior",
        "cmd",
        "type",
        "containsNoneAccount",
        "containsPartTimeEmployee"
      ],
      "notes": "11 字段必填模板；结果行取 id（不是 userid）作为 E10 业务 userId；先查 count 再查 data"
    },
    {
      "id": "POST /api/hrm/common/browser/data/resource",
      "source": "references/daily-report-blog-details-by-date.md",
      "operations": [
        "blog.resolve_users",
        "blog.query_user",
        "blog.remind.prepare"
      ],
      "fields": [
        "id",
        "name",
        "department"
      ],
      "notes": "行数据在 data.data[]；id 为业务 userId"
    },
    {
      "id": "POST /api/blog/prior/addBlog",
      "source": "references/daily-report-blog-add-blog.md",
      "operations": [
        "blog.publish.apply"
      ],
      "fields": [
        "blog.blogTime",
        "blog.content",
        "blog.permissionList",
